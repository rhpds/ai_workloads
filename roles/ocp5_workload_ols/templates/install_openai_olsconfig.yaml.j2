---
apiVersion: ols.openshift.io/v1alpha1
kind: OLSConfig
metadata:
  name: cluster
spec:
  llm:
    providers:
    - credentialsSecretRef:
        name: openai-api-keys
      models:
      - name: "{{ ocp5_workload_ols_openai_model }}"
      name: openai
      type: openai
      url: "{{ ocp5_workload_ols_openai_url }}"
  ols:
    queryFilters:
    - name: ip-address
      pattern: '((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}'
      replaceWith: <IP-ADDRESS>
    defaultModel: "{{ ocp5_workload_ols_openai_model }}"
    defaultProvider: openai
    logLevel: "{{ ocp5_workload_ols_loglevel }}"
    introspectionEnabled: {{ ocp5_workload_ols_introspection_enabled | bool }}
    userDataCollection:
      feedbackDisabled: false
      transcriptsDisabled: false
{%- if ocp5_workload_ols_enable_agentic | bool %}
    deployment:
      alertsAdapter:
        configMapRef:
          name: alerts-adapter-config
{% endif %}
