---
apiVersion: ols.openshift.io/v1alpha1
kind: OLSConfig
metadata:
  name: cluster
spec:
  llm:
    providers:
    - credentialsSecretRef:
        name: rhoai-api-keys
      deploymentName: "{{ ocp5_workload_ols_maas_deployment_name }}"
      models:
      - name: "{{ ocp5_workload_ols_maas_model }}"
      name: red_hat_openshift_ai
      type: rhoai_vllm
      url: "{{ ocp5_workload_ols_maas_url }}"
  ols:
    queryFilters:
    - name: ip-address
      pattern: '((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}'
      replaceWith: <IP-ADDRESS>
    defaultModel: "{{ ocp5_workload_ols_maas_model }}"
    defaultProvider: red_hat_openshift_ai
    logLevel: "{{ ocp5_workload_ols_loglevel }}"
    introspectionEnabled: {{ ocp5_workload_ols_introspection_enabled | bool }}
