---
apiVersion: ols.openshift.io/v1alpha1
kind: OLSConfig
metadata:
  name: cluster
spec:
  llm:
    providers:
    - credentialsSecretRef:
        name: azure-api-keys
      deploymentName: "{{ ocp5_workload_ols_azure_deployment_name }}"
      models:
      - name: "{{ ocp5_workload_ols_azure_model }}"
      name: Azure
      type: azure_openai
      url: "{{ ocp5_workload_ols_azure_url }}"
  ols:
    queryFilters:
    - name: ip-address
      pattern: '((25[0-5]|(2[0-4]|1\d|[1-9]|)\d)\.?\b){4}'
      replaceWith: <IP-ADDRESS>
    defaultModel: "{{ ocp5_workload_ols_azure_model }}"
    defaultProvider: Azure
    logLevel: "{{ ocp5_workload_ols_loglevel }}"
    introspectionEnabled: {{ ocp5_workload_ols_introspection_enabled | bool }}
